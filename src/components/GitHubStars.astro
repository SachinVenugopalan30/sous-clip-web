---
import { REPO, REPO_URL, buildTimeStars } from "../lib/github";

interface Props {
  label?: string;
  class?: string;
}

const { label = "Star on GitHub", class: className } = Astro.props;
const stars = await buildTimeStars();
const starsLabel = (n: number) => `${n} ${n === 1 ? "star" : "stars"}`;
---

<a
  class:list={["gh", className]}
  href={REPO_URL}
  data-gh-stars
  data-repo={REPO}
  aria-label={stars === null ? `${label}` : `${label}, ${starsLabel(stars)}`}
>
  <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"
    ><path
      fill="currentColor"
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
    ></path></svg
  >
  <span class="gh-label">{label}</span>
  <span class="gh-count" data-count hidden={stars === null}>
    <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"
      ><path fill="currentColor" d="M8 .25l2.35 4.76 5.25.77-3.8 3.7.9 5.23L8 12.24l-4.7 2.47.9-5.23-3.8-3.7 5.25-.77z"
      ></path></svg
    >
    <span data-count-value>{stars}</span>
  </span>
</a>

<script>
  // Refresh on every visit so a new star shows up without a rebuild (GitHub's API allows 60 requests/hour per visitor)
  const badges = document.querySelectorAll<HTMLAnchorElement>("[data-gh-stars]");
  const repo = badges[0]?.dataset.repo;
  if (repo) {
    fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: "application/vnd.github+json" } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const n = d?.stargazers_count;
        if (typeof n !== "number") return;
        const text = new Intl.NumberFormat("en", { notation: "compact" }).format(n);
        badges.forEach((a) => {
          const count = a.querySelector<HTMLElement>("[data-count]");
          const value = a.querySelector<HTMLElement>("[data-count-value]");
          if (!count || !value) return;
          value.textContent = text;
          count.hidden = false;
          const label = a.querySelector(".gh-label")?.textContent ?? "GitHub";
          a.setAttribute("aria-label", `${label}, ${n} ${n === 1 ? "star" : "stars"}`);
        });
      })
      .catch(() => {});
  }
</script>

<style>
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .gh:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .gh-count {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-left: 10px;
    border-left: 2px solid currentColor;
    font-variant-numeric: tabular-nums;
  }
  .gh-count[hidden] {
    display: none;
  }
</style>
